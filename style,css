
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#eef2f3;
}

header{
background:#2E8B57;
color:white;
text-align:center;
padding:20px;
}

.container{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:20px;
padding:20px;
}

.card{
background:white;
padding:20px;
border-radius:10px;
box-shadow:0 0 10px rgba(0,0,0,.2);
width:420px;
}

.card img{
width:100%;
border-radius:10px;
margin-top:10px;
}

input{
width:90%;
padding:12px;
margin:20px auto;
display:block;
border-radius:8px;
border:1px solid #999;
font-size:16px;
}

ul{
list-style:none;
}

li{
padding:15px;
margin:10px 0;
background:#4CAF50;
color:white;
cursor:pointer;
border-radius:8px;
transition:.3s;
}

li:hover{
background:#2E8B57;
transform:scale(1.03);
}

#description{
margin-top:15px;
font-size:17px;
}

@media(max-width:768px){

.container{

flex-direction:column;
align-items:center;

}

.card{

width:95%;

}

}
